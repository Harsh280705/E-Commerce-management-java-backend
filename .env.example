# Level 3 environment values (examples only — no real secrets).
# PostgreSQL: Level 3 transactional data ONLY (isolated from Level 2).
POSTGRES_URL=jdbc:postgresql://localhost:5445/ecom_level3
POSTGRES_USER=ecom3
POSTGRES_PASSWORD=ecom3pass

# MongoDB: Level 3 product catalog only.
MONGO_URL=mongodb://localhost:27018/ecom_level3

# RabbitMQ: Level 3 dual-write sync transport.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5683
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Elasticsearch: Level 3 admin order search projection.
ELASTICSEARCH_URL=http://localhost:9211
ELASTICSEARCH_INDEX=level3_orders

# Sync tuning (mirrors Level 2 semantics).
SYNC_QUEUE=level3_order_sync
SYNC_EXCHANGE=level3_orders
SYNC_MAX_RETRIES=5
POLL_INTERVAL_MS=15000
POLL_LOOKBACK_SECONDS=180

# Seed Level 3 demo data on API startup.
RUN_SEED_ON_START=true

# API + frontend.
API_HOST=127.0.0.1
API_PORT=8003
FRONTEND_URL=http://localhost:8082
